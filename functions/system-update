#!/usr/bin/env zsh

system-update() {
    # mise updates
    echo
    echo "mise update:"
    echo
    mise cache clear
    sudo mise self-update
    mise upgrade --bump

    # Flatpak updates
    echo
    echo "flatpak update:"
    echo
    flatpak update
    flatpak uninstall --unused --delete-data

    # Detect distribution and run appropriate package manager
    # 在子 shell 里 source, 避免 NAME/VERSION 等变量泄漏到当前 shell
    local ID=$(. /etc/os-release && print -r -- $ID)

    if [[ $ID == "debian" ]]; then
        echo
        echo "sudo apt update:"
        echo
        sudo apt -U upgrade
    elif [[ $ID == "arch" ]]; then
        echo
        echo "paru update:"
        echo
        paru -Syu
    else
        echo "Unsupported distribution: $ID" >&2
        return 1
    fi
}
